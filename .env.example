# Copy to .env only on first setup. Never commit credentials.
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_NAME=glm-5.3-flash
MODEL_API_KEY=
# Existing QWEN_BASE_URL / QWEN_MODEL / QWEN_API_KEY remain supported.
# MODEL_* takes precedence when nonempty; process environment wins over .env.
MODEL_API_PROFILE=auto
MODEL_REASONING_EFFORT=low

# Optional independent App capability summary model, on the same API endpoint.
# Use a model ID different from MODEL_NAME. Empty means collect evidence only.
SUMMARY_MODEL=
SUMMARY_API_KEY=

# Optional: ADB_PATH=/absolute/path/to/adb
# Optional single-task default: ANDROID_SERIAL=127.0.0.1:CURRENT_PORT
# The cloud example disables semantic dedup; configure a supported embedding
# service before enabling it: EMBEDDING_MODEL / EMBEDDING_BASE_URL / EMBEDDING_API_KEY.
